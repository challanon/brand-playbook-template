{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand playbook indexed file metadata",
  "type": "object",
  "required": ["standard", "type", "brand", "version", "last_validated"],
  "properties": {
    "standard": { "const": "brandbook.md" },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "brand": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^0|[1-9][0-9]*\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "last_validated": { "type": "string", "format": "date" }
  }
}
