{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand playbook root metadata",
  "type": "object",
  "required": ["standard", "spec_version", "brand", "markets", "languages", "default_language", "version", "last_validated", "files"],
  "properties": {
    "standard": { "const": "brandbook.md" },
    "spec_version": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "brand": {
      "type": "object",
      "required": ["name", "slug", "owner"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "markets": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
    "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$" } },
    "default_language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^0|[1-9][0-9]*\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "last_validated": { "type": "string", "format": "date" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "summary"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.md$" },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
